#!/usr/bin/env bash
#SBATCH -J wgs_versions
#SBATCH -p ${SLURM_PARTITION}
#SBATCH -N 1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH -o 99_audit_software_versions.%j.out
# =============================================================================
# Audit the software versions used by the WGS, k-mer, MLST, Mash and kSNP4
# workflows.  A missing environment or executable is recorded rather than
# aborting the job.
#
# Outputs (under VERSION_OUT, or software_version_audit_<timestamp>/):
#   software_versions.tsv       concise tool/version/path/status table
#   system_info.txt             host, OS, SLURM and Conda information
#   conda_lists/                full package list for every available env
#   conda_explicit/             explicit reproducible package specifications
#   conda_history/              Conda environment histories, when available
#   representative_headers/     optional BAM/VCF provenance (see below)
#
# Run:
#   sbatch 99_audit_software_versions.slurm
#
# Optional: recover historical tool provenance from files generated by the run:
#   sbatch --export=ALL,REP_BAM=/path/sample.bam,REP_VCF=/path/sample.vcf.gz \
#          99_audit_software_versions.slurm
#
# Important: this reports the environments as they exist when the audit is run.
# If an environment has subsequently been updated, BAM @PG lines, VCF headers
# and archived run logs are better evidence of the historical run version.
# =============================================================================

set -uo pipefail                    # deliberately no `set -e`
IFS=$'\n\t'
shopt -s nullglob

PIPELINE_DIR="${SLURM_SUBMIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
STAMP="$(date +%Y%m%d_%H%M%S)"
VERSION_OUT="${VERSION_OUT:-${PIPELINE_DIR}/software_version_audit_${STAMP}}"
CONDA_LAUNCHER="${CONDA_LAUNCHER:-${CONDA_LAUNCHER}}"
KSNP4_HOME="${KSNP4_HOME:-$HOME/kSNP4.1pkg}"
REP_BAM="${REP_BAM:-}"
REP_VCF="${REP_VCF:-}"

mkdir -p "$VERSION_OUT"/{conda_lists,conda_explicit,conda_history,representative_headers}
TABLE="$VERSION_OUT/software_versions.tsv"
printf 'environment\ttool\tversion\tversion_source\tconda_package\texecutable\texecutable_sha256\tstatus\n' > "$TABLE"

clean_field() {
  printf '%s' "${1:-}" \
    | tr '\t\r\n' '   ' \
    | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//' \
    | cut -c1-600
}

file_sha256() {
  local f="${1:-}"
  [[ -f "$f" ]] || { printf ''; return 0; }
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$f" 2>/dev/null | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$f" 2>/dev/null | awk '{print $1}'
  else
    printf ''
  fi
}

write_row() {
  local env="$1" tool="$2" version="$3" source="$4" package="$5"
  local executable="$6" checksum="$7" status="$8"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(clean_field "$env")" "$(clean_field "$tool")" \
    "$(clean_field "$version")" "$(clean_field "$source")" \
    "$(clean_field "$package")" "$(clean_field "$executable")" \
    "$(clean_field "$checksum")" "$(clean_field "$status")" >> "$TABLE"
}

if [[ ! -x "$CONDA_LAUNCHER" ]]; then
  echo "[FATAL] Conda launcher is not executable: $CONDA_LAUNCHER" >&2
  exit 2
fi

declare -A ENV_OK

snapshot_env() {
  local env="$1" list="$VERSION_OUT/conda_lists/${env}.txt"
  local explicit="$VERSION_OUT/conda_explicit/${env}.explicit.txt"
  local history="$VERSION_OUT/conda_history/${env}.history.txt" prefix=""

  if "$CONDA_LAUNCHER" list -n "$env" --show-channel-urls > "$list" 2>&1; then
    ENV_OK["$env"]=1
    "$CONDA_LAUNCHER" list -n "$env" --explicit > "$explicit" 2>&1 || true
    prefix="$("$CONDA_LAUNCHER" run -n "$env" bash -c 'printf "%s" "$CONDA_PREFIX"' 2>/dev/null || true)"
    if [[ -f "$prefix/conda-meta/history" ]]; then
      cp "$prefix/conda-meta/history" "$history"
    else
      printf 'Conda history not found under: %s\n' "$prefix" > "$history"
    fi
    echo "[OK] environment: $env ($prefix)"
  else
    ENV_OK["$env"]=0
    printf 'Environment unavailable; no explicit specification generated.\n' > "$explicit"
    printf 'Environment unavailable; no history generated.\n' > "$history"
    echo "[WARN] environment unavailable: $env"
  fi
}

conda_package_version() {
  local env="$1" package="$2"
  [[ "${ENV_OK[$env]:-0}" == 1 && -n "$package" ]] || { printf ''; return 0; }
  "$CONDA_LAUNCHER" list -n "$env" "$package" 2>/dev/null \
    | awk -v p="$package" 'tolower($1)==tolower(p){print $2; exit}'
}

env_executable() {
  local env="$1" executable="$2"
  [[ "${ENV_OK[$env]:-0}" == 1 ]] || { printf ''; return 0; }
  "$CONDA_LAUNCHER" run -n "$env" bash -c 'command -v "$1"' _ "$executable" 2>/dev/null \
    | tail -n 1
}

runtime_version() {
  local env="$1" mode="$2" raw=""
  [[ "${ENV_OK[$env]:-0}" == 1 ]] || { printf ''; return 0; }

  case "$mode" in
    fastp)       raw="$("$CONDA_LAUNCHER" run -n "$env" fastp --version 2>&1 || true)" ;;
    bwa)
      raw="$("$CONDA_LAUNCHER" run -n "$env" bwa 2>&1 || true)"
      raw="$(printf '%s\n' "$raw" | awk '/^Version:/{print "bwa " $2; exit}')"
      ;;
    samtools)    raw="$("$CONDA_LAUNCHER" run -n "$env" samtools --version 2>&1 | head -n 1 || true)" ;;
    bcftools)    raw="$("$CONDA_LAUNCHER" run -n "$env" bcftools --version 2>&1 | head -n 1 || true)" ;;
    snakemake)   raw="$("$CONDA_LAUNCHER" run -n "$env" snakemake --version 2>&1 | head -n 1 || true)" ;;
    genmap)      raw="$("$CONDA_LAUNCHER" run -n "$env" genmap --version 2>&1 | head -n 1 || true)" ;;
    bedtools)    raw="$("$CONDA_LAUNCHER" run -n "$env" bedtools --version 2>&1 | head -n 1 || true)" ;;
    mosdepth)    raw="$("$CONDA_LAUNCHER" run -n "$env" mosdepth --version 2>&1 | head -n 1 || true)" ;;
    smudgeplot)  raw="$("$CONDA_LAUNCHER" run -n "$env" smudgeplot --version 2>&1 | head -n 1 || true)" ;;
    rscript)     raw="$("$CONDA_LAUNCHER" run -n "$env" Rscript --version 2>&1 | head -n 1 || true)" ;;
    stringmlst)  raw="$("$CONDA_LAUNCHER" run -n "$env" stringMLST.py --version 2>&1 | head -n 1 || true)" ;;
    mash)        raw="$("$CONDA_LAUNCHER" run -n "$env" mash --version 2>&1 | head -n 1 || true)" ;;
    shovill)     raw="$("$CONDA_LAUNCHER" run -n "$env" shovill --version 2>&1 | head -n 1 || true)" ;;
    spades)      raw="$("$CONDA_LAUNCHER" run -n "$env" spades.py --version 2>&1 | head -n 1 || true)" ;;
    jellyfish)   raw="$("$CONDA_LAUNCHER" run -n "$env" jellyfish --version 2>&1 | head -n 1 || true)" ;;
    python)      raw="$("$CONDA_LAUNCHER" run -n "$env" python --version 2>&1 | head -n 1 || true)" ;;
    none|'')     raw="" ;;
    *)           raw="" ;;
  esac
  clean_field "$raw"
}

runtime_looks_like_version() {
  local value="${1:-}"
  [[ -n "$value" && "$value" =~ [0-9] ]] || return 1
  [[ ! "$value" =~ [Uu]sage: ]] || return 1
  [[ ! "$value" =~ [Ee]rror ]] || return 1
  [[ ! "$value" =~ [Uu]nrecognized ]] || return 1
  [[ ! "$value" =~ [Uu]nknown[[:space:]_-]*option ]] || return 1
  return 0
}

audit_conda_tool() {
  local env="$1" label="$2" executable_name="$3" package="$4" mode="$5"
  local executable="" runtime="" package_version="" version="" source="" checksum="" status=""

  if [[ "${ENV_OK[$env]:-0}" != 1 ]]; then
    write_row "$env" "$label" "" "" "$package" "" "" "ENV_MISSING"
    return 0
  fi

  executable="$(env_executable "$env" "$executable_name")"
  package_version="$(conda_package_version "$env" "$package")"
  runtime="$(runtime_version "$env" "$mode")"
  runtime_looks_like_version "$runtime" || runtime=""
  [[ -n "$executable" ]] && checksum="$(file_sha256 "$executable")"

  if [[ -n "$runtime" ]]; then
    version="$runtime"; source="runtime CLI"
    [[ -n "$package_version" ]] && source="runtime CLI; Conda package ${package_version}"
    status="OK_RUNTIME"
  elif [[ -n "$package_version" ]]; then
    version="$package_version"; source="Conda package metadata"; status="OK_CONDA"
  elif [[ -n "$executable" ]]; then
    version="unreported"; source="executable checksum"; status="FOUND_VERSION_UNKNOWN"
  else
    version="not found"; source=""; status="TOOL_MISSING"
  fi

  write_row "$env" "$label" "$version" "$source" "$package" "$executable" "$checksum" "$status"
}

detect_ksnp_release() {
  local f hit=""
  for f in "$KSNP4_HOME"/VERSION* "$KSNP4_HOME"/README*; do
    [[ -f "$f" ]] || continue
    hit="$(grep -Eio 'kSNP[[:space:]_.-]*4([.][0-9]+)+' "$f" 2>/dev/null | head -n 1 || true)"
    [[ -n "$hit" ]] && { clean_field "$hit"; return 0; }
  done
  printf ''
}

audit_manual_tool() {
  local label="$1" path="$2" release="${3:-}" checksum="" status="FOUND_VERSION_UNKNOWN" source="executable checksum"
  if [[ ! -x "$path" ]]; then
    write_row "manual:kSNP4" "$label" "not found" "" "manual installation" "$path" "" "TOOL_MISSING"
    return 0
  fi
  checksum="$(file_sha256 "$path")"
  if [[ -n "$release" ]]; then
    status="OK_DOCUMENTED"; source="installation documentation"
  else
    release="unreported"
  fi
  write_row "manual:kSNP4" "$label" "$release" "$source" "manual installation" "$path" "$checksum" "$status"
}

audit_ksnp_dependency() {
  local label="$1" local_path="$2" executable="$3" package="$4"
  if [[ -x "$local_path" ]]; then
    audit_manual_tool "$label" "$local_path" ""
  else
    audit_conda_tool ksnp "$label" "$executable" "$package" none
  fi
}

# ---- System and scheduler provenance ---------------------------------------
{
  echo "audit_time=$(date --iso-8601=seconds 2>/dev/null || date)"
  echo "host=$(hostname -f 2>/dev/null || hostname)"
  echo "uname=$(uname -a)"
  echo "slurm=$(sbatch --version 2>/dev/null | head -n 1 || echo unavailable)"
  echo "conda=$($CONDA_LAUNCHER --version 2>/dev/null || echo unavailable)"
  echo "conda_launcher=$CONDA_LAUNCHER"
  echo "pipeline_dir=$PIPELINE_DIR"
  echo "ksnp4_home=$KSNP4_HOME"
} > "$VERSION_OUT/system_info.txt"

# ---- Environment snapshots -------------------------------------------------
for env in fastp bwasam_snake mosdepth hetero_kmer stringmlst mash ksnp; do
  snapshot_env "$env"
done

# ---- Main WGS workflow ------------------------------------------------------
audit_conda_tool fastp          fastp          fastp          fastp          fastp
audit_conda_tool bwasam_snake   BWA            bwa            bwa            bwa
audit_conda_tool bwasam_snake   SAMtools       samtools       samtools       samtools
audit_conda_tool bwasam_snake   BCFtools       bcftools       bcftools       bcftools
audit_conda_tool bwasam_snake   Snakemake      snakemake      snakemake      snakemake
audit_conda_tool bwasam_snake   GenMap         genmap         genmap         genmap
audit_conda_tool bwasam_snake   BEDTools       bedtools       bedtools       bedtools
audit_conda_tool mosdepth       mosdepth       mosdepth       mosdepth       mosdepth
audit_conda_tool mosdepth       SAMtools       samtools       samtools       samtools

# ---- Reference-free k-mer workflow (FastK k=21 in the current script) ------
audit_conda_tool hetero_kmer    FastK          FastK          fastk          none
audit_conda_tool hetero_kmer    Histex         Histex         fastk          none
audit_conda_tool hetero_kmer    GenomeScope2   genomescope.R  genomescope2   none
audit_conda_tool hetero_kmer    Smudgeplot     smudgeplot     smudgeplot     smudgeplot
audit_conda_tool hetero_kmer    R              Rscript        r-base         rscript

# ---- MLST and Mash workflows ------------------------------------------------
audit_conda_tool stringmlst     stringMLST     stringMLST.py  stringmlst     stringmlst
audit_conda_tool stringmlst     Python         python         python         python
audit_conda_tool mash           Mash           mash           mash           mash

# ---- Assembly preceding kSNP4 ----------------------------------------------
audit_conda_tool ksnp           Shovill        shovill        shovill        shovill
audit_conda_tool ksnp           SPAdes         spades.py      spades         spades
audit_conda_tool ksnp           Jellyfish      jellyfish      jellyfish      jellyfish

# kSNP4 itself is installed manually by the recorded workflow.
KSNP_RELEASE="$(detect_ksnp_release)"
audit_manual_tool kSNP4      "$KSNP4_HOME/kSNP4"      "$KSNP_RELEASE"
audit_manual_tool Kchooser4  "$KSNP4_HOME/Kchooser4"  "$KSNP_RELEASE"
audit_ksnp_dependency FastTreeMP "$KSNP4_HOME/FastTreeMP" FastTreeMP fasttree
audit_ksnp_dependency MUMmer     "$KSNP4_HOME/mummer"     mummer     mummer

# ---- Optional historical provenance from one representative BAM and VCF ----
if [[ -n "$REP_BAM" ]]; then
  if [[ -f "$REP_BAM" && "${ENV_OK[bwasam_snake]:-0}" == 1 ]]; then
    "$CONDA_LAUNCHER" run -n bwasam_snake samtools view -H "$REP_BAM" 2>/dev/null \
      | awk '$1=="@PG"' > "$VERSION_OUT/representative_headers/bam_program_records.sam" || true
  else
    printf 'REP_BAM unavailable or bwasam_snake missing: %s\n' "$REP_BAM" \
      > "$VERSION_OUT/representative_headers/bam_program_records.ERROR.txt"
  fi
fi

if [[ -n "$REP_VCF" ]]; then
  if [[ -f "$REP_VCF" && "${ENV_OK[bwasam_snake]:-0}" == 1 ]]; then
    "$CONDA_LAUNCHER" run -n bwasam_snake bcftools view -h "$REP_VCF" 2>/dev/null \
      | grep -E '^##(bcftools|source|reference)' \
      > "$VERSION_OUT/representative_headers/vcf_provenance.txt" || true
  else
    printf 'REP_VCF unavailable or bwasam_snake missing: %s\n' "$REP_VCF" \
      > "$VERSION_OUT/representative_headers/vcf_provenance.ERROR.txt"
  fi
fi

echo
echo "Software-version audit complete"
echo "  table : $TABLE"
echo "  detail: $VERSION_OUT"
echo
column -t -s $'\t' "$TABLE" 2>/dev/null || cat "$TABLE"
