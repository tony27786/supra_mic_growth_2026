#!/bin/bash
#SBATCH -J cn03_psvcf
#SBATCH -p ${SLURM_PARTITION}
#SBATCH -N 1
#SBATCH --mem=200G
#SBATCH --cpus-per-task=48
#SBATCH -o 03_cn_psvcf_snake.out
# =============================================================================
# Stage 03: per-sample variant calling (Snakemake).
#   per-contig bcftools mpileup|call (ploidy 2) -> concat -> filter
# FLAT layout: Snakefile and the generated config.yaml live in the pipeline dir
# (the same folder as this script and 00_config.sh) -- no 03_vcf/ subdir.
# Filtered VCFs -> $VCF_OUT/vcf/filtered/{sample}.filtered.vcf.gz
# =============================================================================

PIPELINE_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
source "${PIPELINE_DIR}/00_config.sh"
apply_strict_mode

activate_conda "$CONDA_ENV_BWASAM"
print_config_banner

cd "${PIPELINE_DIR}"

# --- Generate config.yaml from shared variables (keeps RUN_TAG consistent) ---
cat > config.yaml <<EOF
# AUTO-GENERATED by 03_vcf.slurm from 00_config.sh  (RUN_TAG=${RUN_TAG})
map_dir: "${MAP_OUT}"
ref_fa: "${REF_FA}"
out_dir: "${VCF_OUT}"

min_mapq: ${VC_MIN_MAPQ}
min_bq: ${VC_MIN_BQ}
ploidy: ${VC_PLOIDY}
call_threads: ${VC_CALL_THREADS}
max_depth: ${VC_MAX_DEPTH}

qual_min: ${VC_QUAL_MIN}
depth_min: ${VC_DEPTH_MIN}

min_contig_len: ${VC_MIN_CONTIG_LEN}
EOF
echo "[$(date '+%F %T')] >>> generated config.yaml:"
sed 's/^/    /' config.yaml

export TMPDIR="${VCF_OUT}/tmp"
mkdir -p "$TMPDIR"

echo "[$(date '+%F %T')] >>> SLURM_CPUS = ${SLURM_CPUS_PER_TASK:-NA}  snakemake jobs = ${VC_SNAKE_JOBS}"

snakemake -s "${PIPELINE_DIR}/Snakefile" -p \
  --cores "${SLURM_CPUS_PER_TASK:-16}" \
  --jobs "${VC_SNAKE_JOBS}" \
  --keep-going \
  --rerun-incomplete \
  --latency-wait 60

echo "[$(date '+%F %T')] >>> VCF stage complete."
echo "Filtered VCFs under: ${VCF_FILTERED_DIR}/"
echo ">>> SLURM BATCH TERMINATED AT [$(date '+%F %T')]"
exit 0
